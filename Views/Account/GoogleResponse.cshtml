@{
    ViewData["Title"] = "Google Authentication Response";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header">
                <h3><i class="fab fa-google text-danger me-2"></i>Google Authentication Response</h3>
            </div>
            <div class="card-body">
                @if (ViewBag.Claims != null)
                {
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Claims Information:</h5>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Value</th>
                                            <th>Issuer</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var claim in ViewBag.Claims)
                                        {
                                            <tr>
                                                <td><code>@claim.Type</code></td>
                                                <td>@claim.Value</td>
                                                <td>@claim.Issuer</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h5>Raw JSON Response:</h5>
                            <div class="bg-light p-3 rounded">
                                <pre class="mb-0"><code>@ViewBag.JsonResult</code></pre>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4 text-center">
                        <a class="btn btn-primary" asp-controller="Movies" asp-action="Index">
                            <i class="fas fa-home me-2"></i>Go to Home
                        </a>
                        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-arrow-left me-2"></i>Back to Login
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        No claims data available. Authentication may have failed.
                    </div>
                    <div class="text-center">
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-arrow-left me-2"></i>Back to Login
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    pre {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 1rem;
        font-size: 0.875rem;
        line-height: 1.5;
        overflow-x: auto;
    }
    
    code {
        color: #d63384;
        background-color: #f8f9fa;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
    }
</style> 